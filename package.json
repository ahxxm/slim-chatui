{
	"name": "slim-chatui",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "vite dev --host",
		"dev:5050": "vite dev --port 5050",
		"build": "vite build",
		"build:watch": "vite build --watch",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"perf:streaming-markdown": "node test/perf/streaming-markdown.mjs",
		"lint": "npm run lint:frontend ; npm run lint:types ; npm run lint:backend",
		"lint:frontend": "eslint . --fix",
		"lint:types": "npm run check",
		"lint:backend": "pylint backend/",
		"format": "prettier --write \"**/*.{js,ts,svelte,css,md,html,json}\"",
		"format:backend": "uv run black . --exclude \".venv/|/venv/|node_modules/\"",
		"i18n:parse": "i18next-cli extract && prettier --write \"src/lib/i18n/**/*.{js,json}\"",
		"test:frontend": "vitest run --passWithNoTests"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.56.1",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/container-queries": "^0.1.1",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.2",
		"@testing-library/svelte": "^5.3.1",
		"@typescript-eslint/eslint-plugin": "^8.58.0",
		"@typescript-eslint/parser": "^8.58.0",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"i18next-cli": "^1.64.2",
		"jsdom": "^29.0.1",
		"postcss": "^8.5.8",
		"prettier": "^3.9.4",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.55.1",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.0.0",
		"tslib": "^2.8.1",
		"typescript": "^6.0.2",
		"vite": "^8.0.3",
		"vitest": "^4.1.2"
	},
	"type": "module",
	"dependencies": {
		"@floating-ui/dom": "^1.7.6",
		"@internationalized/date": "^3.12.0",
		"@joplin/turndown-plugin-gfm": "^1.0.64",
		"@sveltejs/svelte-virtual-list": "^3.0.1",
		"@tiptap/core": "^3.22.2",
		"@tiptap/extension-bubble-menu": "^3.22.2",
		"@tiptap/extension-code-block-lowlight": "^3.22.2",
		"@tiptap/extension-file-handler": "^3.22.2",
		"@tiptap/extension-floating-menu": "^3.22.2",
		"@tiptap/extension-highlight": "^3.22.2",
		"@tiptap/extension-image": "^3.22.2",
		"@tiptap/extension-link": "^3.22.2",
		"@tiptap/extension-list": "^3.22.2",
		"@tiptap/extension-table": "^3.22.2",
		"@tiptap/extension-typography": "^3.22.2",
		"@tiptap/extensions": "^3.22.2",
		"@tiptap/pm": "^3.22.2",
		"@tiptap/starter-kit": "^3.22.2",
		"bits-ui": "^2.17.2",
		"dayjs": "^1.11.20",
		"dompurify": "^3.4.11",
		"focus-trap": "^8.0.1",
		"highlight.js": "^11.11.1",
		"html-entities": "^2.6.0",
		"i18next": "^26.3.4",
		"i18next-browser-languagedetector": "^8.2.1",
		"i18next-resources-to-backend": "^1.2.1",
		"katex": "^0.17.0",
		"lowlight": "^3.3.0",
		"marked": "^18.0.0",
		"panzoom": "^9.4.4",
		"prosemirror-model": "^1.25.4",
		"prosemirror-state": "^1.4.4",
		"prosemirror-view": "^1.41.8",
		"socket.io-client": "^4.8.3",
		"sortablejs": "^1.15.7",
		"svelte-sonner": "^1.1.0",
		"turndown": "^7.2.4",
		"uuid": "^14.0.0"
	},
	"engines": {
		"node": ">=22.0.0 <=24.x.x",
		"npm": ">=6.0.0"
	}
}
