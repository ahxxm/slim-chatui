{
	"name": "slim-chatui",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "vite dev --host",
		"dev:5050": "vite dev --port 5050",
		"build": "vite build",
		"build:watch": "vite build --watch",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"perf:streaming-markdown": "node test/perf/streaming-markdown.mjs",
		"lint": "npm run lint:frontend ; npm run lint:types ; npm run lint:backend",
		"lint:frontend": "eslint . --fix",
		"lint:types": "npm run check",
		"lint:backend": "pylint backend/",
		"format": "prettier --write \"**/*.{js,ts,svelte,css,md,html,json}\"",
		"format:backend": "uv run black . --exclude \".venv/|/venv/|node_modules/\"",
		"i18n:parse": "i18next-cli extract && prettier --write \"src/lib/i18n/**/*.{js,json}\"",
		"test:frontend": "vitest run --passWithNoTests",
		"test:frontend:browser": "VITEST_BROWSER=1 vitest run --passWithNoTests"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/container-queries": "^0.1.1",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.2",
		"@testing-library/svelte": "^5.3.1",
		"@typescript-eslint/eslint-plugin": "^8.72.0",
		"@typescript-eslint/parser": "^8.72.0",
		"@vitest/browser": "^5.0.5",
		"@vitest/browser-playwright": "^5.0.5",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"i18next-cli": "^1.77.0",
		"jsdom": "^29.0.1",
		"playwright": "^1.64.1",
		"postcss": "^8.5.31",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.0.0",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"vite": "^8.3.4",
		"vitest": "^5.0.5"
	},
	"type": "module",
	"dependencies": {
		"@floating-ui/dom": "^1.7.6",
		"@internationalized/date": "^3.12.3",
		"@sveltejs/svelte-virtual-list": "^3.0.1",
		"bits-ui": "^2.19.0",
		"dayjs": "^1.11.23",
		"dompurify": "^3.4.17",
		"focus-trap": "^8.0.1",
		"highlight.js": "^11.12.0",
		"html-entities": "^2.6.0",
		"i18next": "^26.5.3",
		"i18next-browser-languagedetector": "^8.2.1",
		"i18next-resources-to-backend": "^1.2.3",
		"katex": "^0.19.0",
		"lowlight": "^3.3.0",
		"marked": "^18.1.1",
		"panzoom": "^9.4.4",
		"socket.io-client": "^4.8.3",
		"sortablejs": "^1.15.7",
		"svelte-sonner": "^1.2.1",
		"uuid": "^14.0.3"
	},
	"engines": {
		"node": ">=22.0.0 <=24.x.x",
		"npm": ">=6.0.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
